# Másold .env néven, és töltsd ki. A .env NEM kerül verziókezelésbe.

# ---------- Érzékeny adatok ----------
OPENROUTER_API_KEY=
POSTGRES_PASSWORD=
# Az admin oldal és az admin API jelszava (fejléc: X-Admin-Secret). Üres = nincs védelem (csak helyi demóhoz).
ADMIN_SECRET=

# ---------- Portok ----------
HOST_BIND=0.0.0.0
API_PORT=8070
POSTGRES_PORT=5470
PHOENIX_PORT=6070
ADMINER_PORT=8071

# ---------- Postgres ----------
POSTGRES_DB=utmutato
POSTGRES_USER=utmutato

# ---------- Modellek (OpenRouter) ----------
CHAT_MODEL=openai/gpt-4o-mini
# a követő kérdés önálló keresőkérdéssé alakítása, a dokumentum-metaadat
REWRITE_MODEL=openai/gpt-4o-mini
# az alapértelmezett embedding (a chat ezzel keres); a méréshez továbbiak: EVAL_EMBED_MODELS
EMBED_MODEL=baai/bge-m3
EVAL_EMBED_MODELS=baai/bge-m3,openai/text-embedding-3-small,qwen/qwen3-embedding-8b
RERANK_MODEL=cohere/rerank-v3.5
# képleírás (VLM): openai/gpt-4o-mini | none
VLM_MODEL=openai/gpt-4o-mini
# LLM-as-judge a méréshez és a visszajelzés-elemzéshez
JUDGE_MODEL=openai/gpt-4o-mini

# ---------- Beolvasás (Docling, CPU) ----------
OCR_LANGS=hu,en
# ha egy PDF-ben oldalanként átlagosan ennél kevesebb a szövegréteg karaktere -> teljes oldalas OCR
SCANNED_MIN_CHARS_PER_PAGE=50
IMAGES_SCALE=2.0
DOCUMENT_TIMEOUT_S=1800
# CPU-szálak a Doclingnak (0 = automatikus)
DOCLING_THREADS=0

# ---------- Képek ----------
IMAGE_MIN_PX=120
IMAGE_REPEAT_DOCS=3
IMAGE_MAX_PER_DOC=80

# ---------- Chunkolás ----------
# hybrid = a dokumentum szerkezete szerint (Docling HybridChunker) | fixed = fix tokenablak (alapvonal)
CHUNK_STRATEGIES=hybrid,fixed
CHAT_STRATEGY=hybrid
CHUNK_TOKENIZER=BAAI/bge-m3
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=60

# ---------- Keresés ----------
DENSE_CANDIDATES=40
BM25_CANDIDATES=40
RRF_K=60
RERANK_CANDIDATES=25
TOP_K=6
# ennél kisebb rerank-pontszámú találat kimarad (0..1)
RERANK_MIN_SCORE=0.15
MAX_IMAGES=6

# ---------- Phoenix ----------
PHOENIX_PROJECT=utmutato-asszisztens
# a böngészőből elérhető Phoenix-cím (az admin Monitoring fül linkje)
PHOENIX_UI_URL=http://localhost:6070
